<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Редактирование словаря</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <div class="phone-container screen-add">
    
    {{#if hasDraft}}
      <form action="/archaism-dicts-edit/publish/{{dict.id}}" method="POST" class="add-form">
    {{else}}
      <form action="/archaism-dicts-edit/create-draft" method="POST" class="add-form">
    {{/if}}

      <div class="form-group">
        <label class="form-label">Видео</label>
        <div class="file-upload-row">
          <input type="file" class="form-file" accept="video/*" />
          <video src="{{dict.videoUrl}}" class="media-preview" muted loop autoplay></video>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Фото</label>
        <div class="file-upload-row">
          <input type="file" class="form-file" accept="image/*" />
          <img src="{{dict.imageUrl}}" alt="Превью" class="media-preview" />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Название</label>
        <input type="text" name="title" class="form-input" value="{{dict.title}}" placeholder="Введите название..." required />
      </div>

      {{#if hasDraft}}
      <div class="form-group">
        <label class="form-label">Начальная дата</label>
        <input type="date" name="startDate" class="form-input" value="{{dict.startDate}}" />
      </div>

      <div class="form-group">
        <label class="form-label">Конечная дата</label>
        <input type="date" name="endDate" class="form-input" value="{{dict.endDate}}" />
      </div>

      <div class="form-group">
        <label class="form-label">Описание</label>
        <textarea name="description" class="form-textarea" rows="3" placeholder="Введите описание...">{{dict.description}}</textarea>
      </div>
      {{/if}}
      {{#if hasDraft}}
        <button type="submit" class="btn-primary btn-publish">Опубликовать</button>
      {{else}}
        <button type="submit" class="btn-primary">Далее</button>
      {{/if}}

    </form>

    {{> navbar}}
  </div>

</body>
</html>