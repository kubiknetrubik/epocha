<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Добавить словарь</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <div class="phone-container screen-add">
    <div class="add-form">
      
      <div class="form-group">
        <label class="form-label">Название</label>
        <input type="text" class="form-input" value="{{dict.title}}" />
      </div>

      <div class="form-group">
        <label class="form-label">Нижняя граница</label>
        <input type="date" class="form-input" value="{{dict.startDate}}" />
      </div>

      <div class="form-group">
        <label class="form-label">Верхняя граница</label>
        <input type="date" class="form-input" value="{{dict.endDate}}" />
      </div>

      <div class="form-group">
        <label class="form-label">Описание</label>
        <textarea class="form-textarea" rows="3">{{dict.description}}</textarea>
      </div>

      <div class="form-group">
        <label class="form-label">Видео</label>
        <div class="file-upload-row">
          <input type="file" class="form-file" accept="video/*" />
          <video src="{{dict.videoUrl}}" class="media-preview" muted loop autoplay></video>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Фото</label>
        <div class="file-upload-row">
          <input type="file" class="form-file" accept="image/*" />
          <img src="{{dict.imageUrl}}" alt="Превью" class="media-preview" />
        </div>
      </div>

    </div>

    {{> navbar}}
  </div>

</body>
</html>