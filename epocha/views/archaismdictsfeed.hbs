<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{dict.title}}</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="phone-container">

    <video class="bg-video" autoplay muted loop playsinline>
      <source src="{{dict.videoUrl}}" type="video/mp4">
    </video>

    <div class="actions-sidebar">
      <button class="action-btn">
        <img src="/heart.svg" alt="Лайк" class="action-icon" />
        <span>{{likesCount}}</span>
      </button>
      <a href="/archaism-dicts-feed?id={{nextDictId}}" class="action-btn circle-btn">
        <img src="/arrowdown.svg" alt="Следующий" class="action-icon" />
      </a>
      <div class="sidebar-date-info">
        <span class="date-label">Даты</span>
        <span class="date-value">{{dict.startDate}}</span>
        <span class="date-separator">—</span>
        <span class="date-value">{{dict.endDate}}</span>
      </div>
    </div>

    <div class="glass-card">
      <h2 class="card-title">{{dict.title}}</h2>
      <div class="description-header">
        <p class="card-description collapsed" id="descText">
          {{dict.description}}
        </p>
        <button type="button" class="chevron-btn" id="toggleDescBtn" aria-label="Развернуть описание">
          <img src="/chevronup.svg" alt="Ещё" class="chevron-icon" id="chevronIcon" />
        </button>
      </div>
    </div>

    {{> navbar}}

  </div>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggleBtn = document.getElementById('toggleDescBtn');
      const descText = document.getElementById('descText');
      const descCard = document.getElementById('descCard');

      if (toggleBtn && descText) {
        toggleBtn.addEventListener('click', () => {
          descText.classList.toggle('collapsed');
          descCard.classList.toggle('expanded');
        });
      }
    });
  </script>
</body>
</html>